# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only, never prefix with NEXT_PUBLIC_. Needed for admins to create instructor logins.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the deployed site (used for SEO, share images and the sitemap)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
